DT rows: ['ReceptionistGioh_Tutorial', 'Boss_Tutorial', 'Janitor_QuestAvailable', 'FloorManager_Tutorial', 'FloorManager_Break', 'ReceptionistGioh_SpiderOffer', 'ReceptionistGioh_SpiderActive', 'ReceptionistGioh_SpiderThanks', 'Boss_FireGus', 'Gus_Tutorial']
DT csv:
---,DialogueText,NextTextID,HasOptions?,Option1,Option2,Option3
ReceptionistGioh_Tutorial,"NSLOCTEXT(""[C862D8D30FA1DD848D39A91224A6FDE7]"", ""20C708764700F01CB1C67888BF4228A1"", ""\""Welcome. You must be the new hire, right? The Boss is waiting for you. It should be the room all the way to the far left.\"""")","","False","","",""
Boss_Tutorial,"NSLOCTEXT(""[C862D8D30FA1DD848D39A91224A6FDE7]"", ""E4B67D7041D1E5C04138AB8B73D066BF"", ""\""Hi. Nice to see you could make it. I\'m sure you already know what this job entails? Well, lets put you to the test. I think the janitor could use some help.\"""")","","False","","",""
Janitor_QuestAvailable,"NSLOCTEXT(""[C862D8D30FA1DD848D39A91224A6FDE7]"", ""EC4CE3DF45F5A6320A8AB29F08D3C0F8"", ""\""Well, what do we have here? A Human? Well, don\'t matter. You\'re here. Can you help me with somethin\'? There\'s a lotta trash around. Think you can help?\"""")","","True","NSLOCTEXT(""[C862D8D30FA1DD848D39A91224A6FDE7]"", ""B4BCCC5E469FD03A03F5D0BE21BF928B"", ""Ew... a monster"")","NSLOCTEXT(""[C862D8D30FA1DD848D39A91224A6FDE7]"", ""B6A172F743E71E6FDA6BAFAF23A5DF02"", ""What are you?"")","NSLOCTEXT(""[C862D8D30FA1DD848D39A91224A6FDE7]"", ""91574A834590BB3B465F14BD9D3D1516"", ""Sure"")"
FloorManager_Tutorial,"NSLOCTEXT(""[C862D8D30FA1DD848D39A91224A6FDE7]"", ""BFCA18294779AFFF645868B0CD19EAE6"", ""\""Hi, I\'m the floor manager of this place. You the one they hired? Man, you don\'t look like much. Do you even eat? Well, whatever.\"""")","","False","","",""
FloorManager_Break,"NSLOCTEXT(""[C862D8D30FA1DD848D39A91224A6FDE7]"", ""9292837B43D612791EB0C8A9E8ADCE55"", ""Don\'t talk to me. Can\'t you see I\'m on break?"")","","False","","",""
ReceptionistGioh_SpiderOffer,"NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""ReceptionistGioh_SpiderOffer_DialogueText"", ""You took out the trash? Great. Tiny problem: five spiders have moved into the office. I handle visitors, not visitors with eight legs. Could you squash them? Look in the bathroom and around the office. Aim at a spider and left-click when you\'re close."")","","True","NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""ReceptionistGioh_SpiderOffer_Option1"", ""You\'re scared of spiders?"")","NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""ReceptionistGioh_SpiderOffer_Option2"", ""Where should I look?"")","NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""ReceptionistGioh_SpiderOffer_Option3"", ""I\'ll take care of them."")"
ReceptionistGioh_SpiderActive,"NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""ReceptionistGioh_SpiderActive_DialogueText"", ""Five spiders. Check the bathroom and office floor. Aim at them and left-click up close. I\'ll be here, maintaining a very professional distance."")","","False","","",""
ReceptionistGioh_SpiderThanks,"NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""ReceptionistGioh_SpiderThanks_DialogueText"", ""All five? You\'re a lifesaver. If the boss asks, pest control was definitely in your job description. He wanted to see you before you leave. Good luck."")","","False","","",""
Boss_FireGus,"NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""Boss_FireGus_DialogueText"", ""One more thing. Gus, the new hire outside my office, isn\'t working out. Tell him he\'s fired. Yes, you. Consider it your first assignment in employee relations."")","","False","","",""
Gus_Tutorial,"NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""Gus_Tutorial_DialogueText"", ""Hey! I\'m Gus, the new guy. Are you here to help me get settled in?"")","","True","NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""Gus_Tutorial_Option1"", ""How\'s your first day?"")","NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""Gus_Tutorial_Option2"", ""What have you been working on?"")","NSLOCTEXT(""DT_MonsterDialogue [C862D8D30FA1DD848D39A91224A6FDE7]"", ""Gus_Tutorial_Option3"", ""I\'m sorry, Gus. The boss says you\'re fired."")"
